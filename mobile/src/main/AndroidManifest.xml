<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bloqueo con huella de las fotos de progreso -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- CPU despierta durante el descanso con la pantalla apagada (aviso puntual al terminar) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Solo para descargar las imágenes de ejercicios de wger.de (ningún dato del usuario sale del móvil) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 16: notificación del entreno como Live Update (Now Bar en Samsung) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.health.permission.WRITE_EXERCISE" />
    <uses-permission android:name="android.health.permission.WRITE_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.health.permission.WRITE_HEART_RATE" />
    <uses-permission android:name="android.health.permission.WRITE_WEIGHT" />
    <uses-permission android:name="android.health.permission.WRITE_BODY_FAT" />
    <!-- Peso corporal y preparación del día (sueño y pulso en reposo) -->
    <uses-permission android:name="android.health.permission.READ_WEIGHT" />
    <uses-permission android:name="android.health.permission.READ_SLEEP" />
    <uses-permission android:name="android.health.permission.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.health.permission.READ_HEIGHT" />
    <uses-permission android:name="android.health.permission.READ_HEART_RATE" />
    <!-- Historial de más de 30 días (peso de los últimos 90 días, altura) -->
    <uses-permission android:name="android.health.permission.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.health.permission.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.health.permission.WRITE_DISTANCE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Apps de música que se pueden abrir desde el entreno -->
        <package android:name="com.apple.android.music" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.sec.android.app.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="deezer.android.app" />
        <package android:name="com.aspiro.tidal" />
        <!-- Búsqueda de ejercicios por voz -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".BeStrongApplication"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeStrong"
        android:resizeableActivity="true">

        <!-- Continuidad de app en el Fold: el estado se conserva al plegar/desplegar -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rutina compartida por enlace o QR: bestrong://routine?d=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bestrong" android:host="routine" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".PrivacyPolicyActivity"
            android:exported="true"
            android:label="@string/privacy">
            <!-- Health Connect: explicación de permisos (Android 13 y anteriores) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect: explicación de permisos (Android 14+) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PrivacyPolicyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".workout.WorkoutForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cronómetro del entrenamiento y temporizador de descanso entre series" />
        </service>

        <service
            android:name=".sync.WatchSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/bestrong" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/bestrong/metrics" />
            </intent-filter>
        </service>

        <!-- Imagen del entreno para compartir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Mosaico de ajustes rápidos: empezar o abrir el entreno -->
        <service
            android:name=".widget.QuickStartTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_dumbbell"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- Respuesta directa a la notificación de pesarse (solo desde la propia app) -->
        <receiver
            android:name=".notify.WeighInReplyReceiver"
            android:exported="false" />
        <!-- «Copiar ahora» del aviso de copia automática fallida -->
        <receiver
            android:name=".backup.BackupNowReceiver"
            android:exported="false" />
        <!-- Viaje con cambio de huso u hora cambiada a mano: los avisos se reprograman a la hora local -->
        <receiver
            android:name="com.bestrong.mobile.notify.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <!-- «Dentro de 1 h» del recordatorio de entrenar -->
        <receiver
            android:name=".notify.ReminderSnoozeReceiver"
            android:exported="false" />
        <receiver
            android:name=".widget.BeStrongWidgetReceiver"
            android:exported="true"
            android:label="BeStrong">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bestrong_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MuscleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_muscles_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/muscle_widget_info" />
        </receiver>
    </application>
</manifest>
