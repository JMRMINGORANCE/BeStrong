<?xml version="1.0" encoding="utf-8"?>
<!-- Atajos al mantener pulsado el icono (también usables desde Bixby Routines y Modos y rutinas) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start_empty"
        android:enabled="true"
        android:icon="@drawable/ic_stat_dumbbell"
        android:shortcutShortLabel="@string/shortcut_empty_short"
        android:shortcutLongLabel="@string/shortcut_empty_long">
        <intent
            android:action="com.bestrong.START_EMPTY"
            android:targetClass="com.bestrong.mobile.MainActivity"
            android:targetPackage="com.copidev.bestrong" />
    </shortcut>
    <shortcut
        android:shortcutId="open_workout"
        android:enabled="true"
        android:icon="@drawable/ic_stat_dumbbell"
        android:shortcutShortLabel="@string/shortcut_open_short"
        android:shortcutLongLabel="@string/shortcut_open_long">
        <intent
            android:action="com.bestrong.OPEN_WORKOUT"
            android:targetClass="com.bestrong.mobile.MainActivity"
            android:targetPackage="com.copidev.bestrong" />
    </shortcut>
</shortcuts>
