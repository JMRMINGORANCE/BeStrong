    <string name="propuesta5_care_title">Une zone à ménager ?</string>
    <string name="propuesta5_care_hint">Facultatif. Si quelque chose te gêne, le programme évite les exercices qui sollicitent le plus cette zone et utilise des alternatives plus contrôlées.</string>
