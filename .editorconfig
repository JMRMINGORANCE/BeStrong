# Estilo de código comprobado por ktlint (vía Spotless en la CI: ./gradlew spotlessCheck)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = off
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Los @Composable empiezan con mayúscula
ktlint_function_naming_ignore_when_annotated_with = Composable
# Reglas que chocan con el estilo compacto del proyecto
ktlint_standard_filename = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_if-else-bracing = disabled
ktlint_standard_blank-line-before-declaration = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_backing-property-naming = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_discouraged-comment-location = disabled
ktlint_standard_comment-wrapping = disabled
ktlint_standard_condition-wrapping = disabled
ktlint_standard_annotation = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_kdoc = disabled

[*.{xml,yml,json}]
indent_size = 2
